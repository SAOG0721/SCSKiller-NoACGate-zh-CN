<Page
    x:Class="SCSKiller.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SCSKiller.App">

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="36,28,36,28" Spacing="16">
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Vm.CacheTitle}" Style="{StaticResource Section}" />
                        <TextBlock Text="{x:Bind Vm.CacheIntro}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="当前上限" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.CurrentLimit, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="当前已用" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.Used, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{x:Bind Vm.FreeLabel, Mode=OneWay}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.Free, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="14" Visibility="{x:Bind Vm.Configurable}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NewLimitLabel" Text="新上限" VerticalAlignment="Center" />
                            <ComboBox x:Name="SizeBox" Grid.Column="1" ItemsSource="{x:Bind local:SettingsVm.SizeLabels}" MinWidth="220"
                                      SelectedIndex="{x:Bind Vm.SizeIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{x:Bind NewLimitLabel}" />
                            <Button x:Name="ApplyButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnApply">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                    <TextBlock Text="应用（需要管理员权限）" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <InfoBar IsOpen="{x:Bind Vm.HasApplyMessage, Mode=OneWay}" Visibility="{x:Bind Vm.HasApplyMessage, Mode=OneWay}" Message="{x:Bind Vm.ApplyMessage, Mode=OneWay}"
                                 Severity="{x:Bind Vm.ApplySeverity, Mode=OneWay}" IsClosable="False" />
                        <TextBlock Text="你可以随时在这里恢复驱动默认值。" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <InfoBar IsOpen="{x:Bind Vm.NotConfigurable}" Visibility="{x:Bind Vm.NotConfigurable}" Severity="Informational" IsClosable="False" Message="{x:Bind Vm.NotConfigurableText}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="编译使用的显卡" Style="{StaticResource Section}" />
                        <TextBlock Text="{x:Bind Vm.GpuIntro}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GpuLabel" Text="显卡" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="360"
                                  ItemsSource="{x:Bind Vm.GpuChoices}"
                                  SelectedIndex="{x:Bind Vm.GpuIndex, Mode=TwoWay}"
                                  AutomationProperties.LabeledBy="{x:Bind GpuLabel}" />
                    </Grid>
                    <InfoBar IsOpen="{x:Bind Vm.HasGpuNote, Mode=OneWay}" Visibility="{x:Bind Vm.HasGpuNote, Mode=OneWay}"
                             Severity="{x:Bind Vm.GpuSeverity}" Message="{x:Bind Vm.GpuNote, Mode=OneWay}" IsClosable="False" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="驱动更新后" Style="{StaticResource Section}" />
                        <TextBlock Text="更新显卡驱动后，已编译的着色器缓存会失效；重新编译前，游戏可能再次出现卡顿。"
                                   Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        <RadioButtons SelectedIndex="{x:Bind Vm.DriverMode, Mode=TwoWay}" AutomationProperties.Name="何时重新编译">
                            <RadioButton AutomationProperties.Name="先询问我">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="先询问我" />
                                    <TextBlock Text="通过通知选择立即编译、空闲时编译或跳过；不会自行启动。" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="电脑空闲时自动编译">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="电脑空闲时自动编译" />
                                    <TextBlock Text="操作鼠标或键盘时立即暂停，空闲后从上次进度继续。" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="关闭">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="关闭" />
                                    <TextBlock Text="需要时在游戏库中手动重新编译。" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                        <TextBlock Text="{x:Bind Vm.LastRebuilt, Mode=OneWay}" Style="{StaticResource Caption}" Visibility="{x:Bind Vm.HasLastRebuilt, Mode=OneWay}" />
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <CheckBox Content="运行其他游戏时暂停后台编译" IsChecked="{x:Bind Vm.PauseWhileGaming, Mode=TwoWay}" />
                        <Grid>
                            <TextBlock Text="后台编译线程数" />
                            <TextBlock Text="{x:Bind Vm.BackgroundThreadsText, Mode=OneWay}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="1" Maximum="{x:Bind Vm.MaxThreads}" StepFrequency="1" Value="{x:Bind Vm.BackgroundThreads, Mode=TwoWay}"
                                 AutomationProperties.Name="后台编译线程数" />
                        <StackPanel Spacing="12" Visibility="{x:Bind Vm.IsNvidia}">
                            <StackPanel Spacing="8">
                                <CheckBox x:Name="AutoBox" Content="自动着色器编译（NVIDIA 测试版）" IsChecked="{x:Bind Vm.AutoOn, Mode=TwoWay}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Header="系统资源占用" ItemsSource="{x:Bind local:SettingsVm.AutoLevels}" SelectedIndex="{x:Bind Vm.AutoLevelIndex, Mode=TwoWay}"
                                              IsEnabled="{Binding IsChecked, ElementName=AutoBox}" MinWidth="140" />
                                    <Button x:Name="AutoApplyButton" Grid.Column="2" Click="OnApplyAuto" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                            <TextBlock Text="应用（需要管理员权限）" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{x:Bind Vm.AutoShaderText, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <InfoBar IsOpen="{x:Bind Vm.HasAutoMessage, Mode=OneWay}" Visibility="{x:Bind Vm.HasAutoMessage, Mode=OneWay}" Message="{x:Bind Vm.AutoMessage, Mode=OneWay}"
                                         Severity="{x:Bind Vm.AutoSeverity, Mode=OneWay}" IsClosable="False" />
                            </StackPanel>
                            <InfoBar IsOpen="True" Severity="Informational" IsClosable="False" Title="建议开启"
                                     Message="NVIDIA App 的测试版功能会在驱动更新后重新编译玩过的游戏；SCSKiller 可补充其余着色器。两者重复部分的开销较小。" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border x:Name="PatreonCard" Style="{StaticResource Card}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Patreon 与上游社区数据库" Style="{StaticResource Section}" />
                            <StackPanel Spacing="12" Visibility="{x:Bind Patreon.SignedOut, Mode=OneWay}">
                                <TextBlock Text="上游项目的 Patreon 会员可使用社区着色器哈希数据库。登录及开启下载后会连接上游服务；本 fork 默认关闭社区同步，也尚未发布测试版或预览版更新。"
                                           Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Style="{StaticResource AccentButtonStyle}" Content="使用 Patreon 登录" Click="OnSignIn" IsEnabled="{x:Bind Patreon.Idle, Mode=OneWay}" />
                                    <Button Content="取消" Click="OnCancelSignIn" Visibility="{x:Bind Patreon.SigningIn, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="请在浏览器中完成登录，这里无需进一步操作。" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Visibility="{x:Bind Patreon.SigningIn, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Spacing="12" Visibility="{x:Bind Patreon.SignedIn, Mode=OneWay}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="已登录 Patreon" />
                                    <TextBlock Text="{x:Bind Patreon.Benefits, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="刷新状态" Click="OnRefreshAccount" IsEnabled="{x:Bind Patreon.Idle, Mode=OneWay}" />
                                    <Button Content="退出登录" Click="OnSignOut" IsEnabled="{x:Bind Patreon.CanSignOut, Mode=OneWay}" />
                                    <ProgressRing IsActive="{x:Bind Patreon.Busy, Mode=OneWay}" Width="16" Height="16" />
                                </StackPanel>
                                <InfoBar IsOpen="{x:Bind Patreon.OffersSharing, Mode=OneWay}" Visibility="{x:Bind Patreon.OffersSharing, Mode=OneWay}" Severity="Success" IsClosable="False"
                                         Title="要向上游社区数据库匿名分享着色器哈希吗？"
                                         Message="此操作会上传游戏的着色器哈希，不会关联你的 Patreon 账号。">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                        <Button Style="{StaticResource AccentButtonStyle}" Content="匿名分享" Click="OnShare" />
                                        <Button Content="暂不" Click="OnNotNow" />
                                    </StackPanel>
                                </InfoBar>
                            </StackPanel>
                            <InfoBar IsOpen="{x:Bind Patreon.HasProblem, Mode=OneWay}" Visibility="{x:Bind Patreon.HasProblem, Mode=OneWay}" Message="{x:Bind Patreon.Problem, Mode=OneWay}"
                                     Severity="Warning" IsClosable="False" />
                            <StackPanel Spacing="8" Visibility="{x:Bind Patreon.ShowsUpdates, Mode=OneWay}">
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <ComboBox Header="本 fork 更新渠道" ItemsSource="{x:Bind Patreon.ChannelLabels, Mode=OneWay}" SelectedIndex="{x:Bind Patreon.ChannelIndex, Mode=TwoWay}"
                                          IsEnabled="{x:Bind Patreon.CanPickChannel, Mode=OneWay}" MinWidth="260" Visibility="{x:Bind Patreon.ShowsChannels, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Patreon.ChannelNote, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <Button Content="立即返回稳定版" Click="OnBackToStable" IsEnabled="{x:Bind Patreon.CanPickChannel, Mode=OneWay}" Visibility="{x:Bind Patreon.OffersBackToStable, Mode=OneWay}" />
                                <InfoBar IsOpen="{x:Bind Patreon.HasUpdateProblem, Mode=OneWay}" Visibility="{x:Bind Patreon.HasUpdateProblem, Mode=OneWay}"
                                         Message="{x:Bind Patreon.UpdateProblem, Mode=OneWay}" Severity="Warning" IsClosable="False" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <StackPanel Spacing="4">
                                <CheckBox IsChecked="{x:Bind Patreon.UseCommunityDb, Mode=TwoWay}" IsEnabled="{x:Bind Patreon.HasDb, Mode=OneWay}" AutomationProperties.Name="下载共享着色器哈希">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="下载共享着色器哈希" TextWrapping="Wrap" />
                                        <TextBlock Text="使用其他玩家录制的哈希信息预编译你的游戏；实际着色器仍从你本机的游戏文件读取。FSR、XeSS 等超分辨率管线信息向所有用户开放。"
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Text="{x:Bind Patreon.DbNote, Mode=OneWay}" Visibility="{x:Bind Patreon.HasDbNote, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,0,0,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{x:Bind Vm.ShareRecordings, Mode=TwoWay}" AutomationProperties.Name="向上游匿名分享着色器哈希">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="向上游匿名分享着色器哈希" TextWrapping="Wrap" />
                                    <TextBlock Text="帮助其他用户改善覆盖率。录制得到的 FSR、XeSS 等超分辨率管线信息也会分享给使用相同版本的用户。不会关联 Patreon 账号；不会上传游戏文件。" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="队列编译速度" Style="{StaticResource Section}" />
                            <Grid>
                                <TextBlock Text="编译线程数" />
                                <TextBlock Text="{x:Bind Vm.ThreadsText, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="1" Maximum="{x:Bind Vm.MaxThreads}" StepFrequency="1" Value="{x:Bind Vm.Threads, Mode=TwoWay}"
                                     AutomationProperties.Name="编译线程数" />
                            <TextBlock Text="{x:Bind Vm.PriorityNote, Mode=OneWay}" Style="{StaticResource Caption}" />
                            <Grid>
                                <TextBlock Text="编译最大内存" />
                                <TextBlock Text="{x:Bind Vm.MaxCompileMemoryText, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="16" StepFrequency="1" Value="{x:Bind Vm.MaxCompileMemory, Mode=TwoWay}"
                                     AutomationProperties.Name="编译最大内存（0 为自动）" />
                            <TextBlock Text="{x:Bind Vm.MaxCompileMemoryNote}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <CheckBox IsChecked="{x:Bind Vm.MaximumPlans, Mode=TwoWay}" AutomationProperties.Name="最大模式：编译所有着色器组合">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="最大模式：编译所有着色器组合" TextWrapping="Wrap" />
                                    <TextBlock Text="可能对 AMD 显卡更有帮助，但编译更久、占用更多磁盘空间。"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="后台行为" Style="{StaticResource Section}" />
                        <CheckBox IsChecked="{x:Bind Vm.StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="登录 Windows 时启动本 fork">
                            <StackPanel Spacing="2">
                                <TextBlock Text="登录 Windows 时启动本 fork" TextWrapping="Wrap" />
                                <TextBlock Text="程序会驻留在时钟旁的通知区域，并在驱动更新后提示重新编译。"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.CloseQuits, Mode=TwoWay}" AutomationProperties.Name="关闭窗口时退出程序">
                            <StackPanel Spacing="2">
                                <TextBlock Text="关闭窗口时退出程序" TextWrapping="Wrap" />
                                <TextBlock Text="正在运行的编译会先保存结果。关闭此项时，窗口关闭后程序仍驻留通知区域；右键点击图标可退出。"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.ScanAtStart, Mode=TwoWay}" AutomationProperties.Name="启动时扫描游戏">
                            <StackPanel Spacing="2">
                                <TextBlock Text="启动时扫描游戏" TextWrapping="Wrap" />
                                <TextBlock Text="重新读取游戏目录中的变化。关闭后先显示上次的列表；刷新、游戏退出或 Steam/Xbox 更新时会重新读取相关游戏。"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.NotifyNewShaders, Mode=TwoWay}" AutomationProperties.Name="有新着色器可编译时通知我">
                            <StackPanel Spacing="2">
                                <TextBlock Text="有新着色器可编译时通知我" TextWrapping="Wrap" />
                                <TextBlock Text="当录制、共享哈希或程序更新带来新管线时通知一次；游玩期间不会打扰。"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.ActiveCheck, Mode=TwoWay}" AutomationProperties.Name="发送匿名每日活跃检查">
                            <StackPanel Spacing="2">
                                <TextBlock Text="发送匿名每日活跃检查" TextWrapping="Wrap" />
                                <TextBlock Text="此检查连接上游服务，每天发送一次程序版本和显卡厂商以统计活跃安装量；不包含游戏信息或用户标识。"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="在所有兼容游戏中自动录制" Style="{StaticResource Section}" />
                                <TextBlock Text="为未检测到反作弊的兼容游戏安装 d3d12.dll，记录遗漏的着色器和帧时间；帧时间仅保存在本机。反作弊游戏必须在详情页单独阅读警告并确认，本开关不会自动授权。关闭后会从未单独开启的游戏中移除录制器。"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent="" IsOn="{x:Bind Vm.RecordAllGames, Mode=TwoWay}"
                                          AutomationProperties.Name="在所有兼容游戏中自动录制" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.RecordingCount, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,6" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RecordingLimitLabel" Text="每个游戏的录制容量上限" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind local:SettingsVm.RecordingLimitLabels}" MinWidth="140"
                                      SelectedIndex="{x:Bind Vm.RecordingLimitIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{x:Bind RecordingLimitLabel}" />
                        </Grid>
                        <TextBlock Text="包含游戏目录中的录制数据和 SCSKiller 的副本。达到上限后游戏仍可正常运行，只是不再记录新管线。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Vm.RecordingSpace, Mode=OneWay}" TextWrapping="Wrap" />
                        <Expander Header="各游戏占用空间" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind Vm.HasRecordings, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind Vm.Recordings, Mode=OneWay}">
                                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:DetailRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind HasNote}" Foreground="{ThemeResource WarnBrush}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
